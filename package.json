{
  "name": "seraphine-group-digest",
  "version": "0.1.0",
  "private": false,
  "description": "Seraphine: local QQ/WeChat group intelligence for DeepSeek Harness — collect messages, track key members, generate human-approved reports, extract schedules. MCP server + DSH bundle.",
  "type": "module",
  "main": "src/hub.js",
  "exports": {
    ".": "./src/hub.js",
    "./mcp": "./src/mcp-server.js",
    "./waker": "./dsh/group-waker.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "seraphine": "src/cli.js",
    "seraphine-mcp": "src/mcp-server.js"
  },
  "files": [
    "app",
    "bridges",
    "config.example.json",
    "cordis.patch.yml",
    "dsh",
    "scripts",
    "src",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanwujiehuyi-web/Seraphine.git"
  },
  "homepage": "https://github.com/wanwujiehuyi-web/Seraphine",
  "bugs": {
    "url": "https://github.com/wanwujiehuyi-web/Seraphine/issues"
  },
  "author": "wanwujiehuyi-web",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "launch": "node src/launcher.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "init": "node src/cli.js init",
    "start": "node src/hub.js",
    "status": "node src/cli.js status",
    "demo": "node src/cli.js demo",
    "digest": "node src/cli.js digest",
    "test": "node test/run.js",
    "simulator": "node test/onebot-simulator.js",
    "relay": "node bridges/wechat-relay.mjs"
  },
  "keywords": [
    "qq",
    "wechat",
    "onebot",
    "group-chat",
    "digest",
    "mcp",
    "dsh",
    "dsh-bundle",
    "seraphine"
  ],
  "license": "MIT"
}
